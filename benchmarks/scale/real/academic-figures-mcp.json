 {
  "type": "function",
  "function": {
   "name": "verify_figure",
   "description": "Run the automated quality gate on a generated figure.\n\nUses vision self-check to evaluate 8 quality domains and verify CJK text\nrendering accuracy. Returns pass/fail verdict, domain scores, and any\nmissing or garbled labels.\n\nexpected_labels: Exact text strings (e.g. CJK labels) the figure should contain.\n",
   "parameters": {
    "properties": {
     "image_path": {
      "title": "Image Path",
      "type": "string"
     },
     "expected_labels": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Expected Labels"
     },
     "figure_type": {
      "default": "infographic",
      "title": "Figure Type",
      "type": "string"
     },
     "language": {
      "default": "zh-TW",
      "title": "Language",
      "type": "string"
     }
    },
    "required": [
     "image_path"
    ],
    "title": "verify_figureArguments",
    "type": "object"
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "multi_turn_edit",
   "description": "Iteratively refine a figure through a multi-turn editing session.\n\nSends multiple editing instructions turn-by-turn to fix CJK labels,\nadjust layout, or improve details. Each turn builds on the previous\nresult for precise iterative corrections.\n\ninstructions: List of natural language editing instructions applied in order.\nExamples: [\"修正標題為「急性冠心症處置流程」\", \"箭頭改紅色\", \"加大字體\"]\n",
   "parameters": {
    "properties": {
     "image_path": {
      "title": "Image Path",
      "type": "string"
     },
     "instructions": {
      "items": {
       "type": "string"
      },
      "title": "Instructions",
      "type": "array"
     },
     "max_turns": {
      "default": 5,
      "title": "Max Turns",
      "type": "integer"
     }
    },
    "required": [
     "image_path",
     "instructions"
    ],
    "title": "multi_turn_editArguments",
    "type": "object"
   }
  }
 }

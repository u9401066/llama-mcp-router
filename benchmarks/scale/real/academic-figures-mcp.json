[
 {
  "type": "function",
  "function": {
   "name": "plan_figure",
   "description": "Plan the best figure type, route, and guardrails before generation.\n\nThis tool returns a structured plan so an MCP host can decide whether to use\ndirect image generation, SVG-style rendering, or deterministic chart routes.\n\nProvide either pmid or a generic source brief. Generic planning supports\npreprints, repositories, and freeform briefs by passing source_title plus\noptional source_summary and source_identifier.\n\noutput_format: Optional final raster delivery type such as png, gif, jpeg, or webp.\nThe planner stores this preference inside planned_payload for downstream rendering.\n\nexpected_labels: Optional list of exact text labels (especially CJK) the\nfigure must contain. Enables CJK text fidelity guardrails and model escalation.\n",
   "parameters": {
    "properties": {
     "pmid": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Pmid"
     },
     "source_title": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Source Title"
     },
     "source_summary": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Source Summary"
     },
     "source_kind": {
      "default": "paper",
      "title": "Source Kind",
      "type": "string"
     },
     "source_identifier": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Source Identifier"
     },
     "output_format": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Output Format"
     },
     "figure_type": {
      "default": "auto",
      "title": "Figure Type",
      "type": "string"
     },
     "style_preset": {
      "default": "journal_default",
      "title": "Style Preset",
      "type": "string"
     },
     "language": {
      "default": "zh-TW",
      "title": "Language",
      "type": "string"
     },
     "output_size": {
      "default": "1024x1536",
      "title": "Output Size",
      "type": "string"
     },
     "target_journal": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Target Journal"
     },
     "expected_labels": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Expected Labels"
     }
    },
    "title": "plan_figureArguments",
    "type": "object"
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "generate_figure",
   "description": "Generate a publication-ready visual asset.\n\nSingle high-level entrypoint: callers may provide planned_payload directly,\nor pass a PMID / generic source brief and let the use case plan internally\nbefore rendering.\n\noutput_format: Optional final raster delivery type such as png, gif, jpeg, or webp.\nMCP applies the conversion internally after generation when possible.\n\nfigure_type: auto | flowchart | mechanism | comparison |\n             infographic | anatomical | timeline | data_visualization\n",
   "parameters": {
    "properties": {
     "pmid": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Pmid"
     },
     "source_title": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Source Title"
     },
     "source_summary": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Source Summary"
     },
     "source_kind": {
      "default": "paper",
      "title": "Source Kind",
      "type": "string"
     },
     "source_identifier": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Source Identifier"
     },
     "planned_payload": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Planned Payload"
     },
     "figure_type": {
      "default": "auto",
      "title": "Figure Type",
      "type": "string"
     },
     "language": {
      "default": "zh-TW",
      "title": "Language",
      "type": "string"
     },
     "output_size": {
      "default": "1024x1536",
      "title": "Output Size",
      "type": "string"
     },
     "output_format": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Output Format"
     },
     "output_dir": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Output Dir"
     },
     "target_journal": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Target Journal"
     }
    },
    "title": "generate_figureArguments",
    "type": "object"
   }
  }
 },

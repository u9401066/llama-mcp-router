 {
  "type": "function",
  "function": {
   "name": "prepare_publication_image",
   "description": "Resize a raster image and write publication DPI metadata using code only.\n\nThis tool never calls image-generation providers. To truly meet 600 DPI for\nfinal publication size, pass width_mm and/or height_mm. Without a final print\nsize it preserves pixel dimensions and writes target_dpi metadata only.\n\noutput_format: Optional raster delivery type: png, jpeg, or tiff.\n",
   "parameters": {
    "properties": {
     "image_path": {
      "title": "Image Path",
      "type": "string"
     },
     "output_path": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Output Path"
     },
     "target_dpi": {
      "default": 600,
      "title": "Target Dpi",
      "type": "integer"
     },
     "width_mm": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Width Mm"
     },
     "height_mm": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Height Mm"
     },
     "output_format": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Output Format"
     },
     "preserve_aspect_ratio": {
      "default": true,
      "title": "Preserve Aspect Ratio",
      "type": "boolean"
     },
     "allow_upscale": {
      "default": true,
      "title": "Allow Upscale",
      "type": "boolean"
     }
    },
    "required": [
     "image_path"
    ],
    "title": "prepare_publication_imageArguments",
    "type": "object"
   }
  }
 },
 {
